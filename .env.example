# ==============================================================================
# lexgraph-lah Environment Configuration
# Copy this file to `.env` for local development or Docker Compose orchestration:
#   cp .env.example .env
# ==============================================================================

# Application runtime environment (development | test | production)
# When ENV=production, AUTH_MODE must NOT be "disabled" (fail-closed HTTP 503).
ENV=development
APP_ENV=development

# Google Gemini API Key (leave as mock-key-for-ci for offline deterministic mode)
GEMINI_API_KEY=mock-key-for-ci

# Model identifiers & complexity tier mapping
MODEL_NAME=gemini-2.5-flash
LEXGRAPH_MODEL_FAST=gemini-2.5-flash
LEXGRAPH_MODEL_REASONING=gemini-2.5-pro
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5

# Arize Phoenix OpenTelemetry OTLP HTTP collector endpoint
# Local uv run default: http://localhost:6006/v1/traces
# Docker Compose override: http://phoenix:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# FinOps token pricing & BNM FX conversion parameters (USD -> MYR)
USD_TO_MYR_RATE=4.40
LEXGRAPH_USD_MYR_FALLBACK=4.40
INPUT_COST_PER_1M_USD=0.15
OUTPUT_COST_PER_1M_USD=0.60
BNM_FX_ENABLED=false
BNM_FX_API_URL=https://api.bnm.gov.my/public/exchange-rate
BNM_FX_CACHE_TTL_SECONDS=86400

# Deterministic Abstention Gate & Pre-Flight PII Scrubber
ABSTENTION_THRESHOLD=0.78
PII_SCRUB_ENABLED=true

# Phase 2: Graph Persistence Backend (memory | neo4j) & OCR Provider (none | tesseract | gemini_vision)
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexgraph-dev-password
NEO4J_DATABASE=neo4j
OCR_PROVIDER=none

# Phase 3: Enterprise AuthN/RBAC, Rate Limiting & Zip-Bomb Guards
# AUTH_MODE: disabled | api_key | jwt
AUTH_MODE=disabled
AUTH_API_KEYS_JSON=
JWT_SECRET=
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=
JWT_AUDIENCE=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPM=120
RATE_LIMIT_WINDOW_SECONDS=60
DOCX_MAX_UNCOMPRESSED_BYTES=26214400
DOCX_MAX_COMPRESSION_RATIO=100.0
DOCX_MAX_ENTRIES=500

# Phase 3: Cross-Worker Encrypted PII Session Store (memory | sqlite | redis)
PII_VAULT_BACKEND=memory
PII_VAULT_DB_PATH=:memory:
PII_VAULT_REDIS_URL=redis://localhost:6379/0
PII_VAULT_TTL_SECONDS=1800
# Optional base64-encoded 32-byte key (or passphrase hashed via SHA-256)
PII_VAULT_ENCRYPTION_KEY_B64=

# Phase 3: Tamper-Evident Ed25519 Signed Attestation Ledger (sqlite | postgres)
ATTESTATION_BACKEND=sqlite
ATTESTATION_DB_PATH=:memory:
ATTESTATION_POSTGRES_DSN=
ATTESTATION_ED25519_PRIVATE_KEY_PEM=
ATTESTATION_ED25519_KEY_ID=lexgraph-ed25519-v1
