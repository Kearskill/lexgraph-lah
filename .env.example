# ==============================================================================
# lexgraph-lah Environment Configuration
# Copy this file to `.env` for local development or Docker Compose orchestration:
#   cp .env.example .env
# ==============================================================================

# Application runtime environment (development | test | production)
APP_ENV=development

# Google Gemini API Key (used by ChatGoogleGenerativeAI in risk_assessor_node)
# Leave as mock-key-for-ci to use offline deterministic demo/mock evaluation mode.
GEMINI_API_KEY=your_key_here

# Gemini model identifier for structured Pydantic v2 clause extraction
MODEL_NAME=gemini-2.5-flash

# Arize Phoenix OpenTelemetry OTLP HTTP collector endpoint
# Local uv run default: http://localhost:6006/v1/traces
# Docker Compose override: http://phoenix:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# FinOps token pricing & FX conversion parameters (USD -> MYR)
USD_TO_MYR_RATE=4.40
INPUT_COST_PER_1M_USD=0.15
OUTPUT_COST_PER_1M_USD=0.60
